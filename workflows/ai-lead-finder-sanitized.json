        "jsonBody": "={{ JSON.stringify({\n  model: 'llama-3.3-70b-versatile',\n  messages: [ {role:'system', content: 'You are an AI receptionist. Never fabricate policy, price or availability. Classify intent (FAQ,SALES,BOOKING,SUPPORT,COMPLAINT,HUMAN_REQUEST,OTHER). Return ONLY strict JSON: {\\\"intent\\\":\\\"\\\",\\\"reply\\\":\\\"\\\",\\\"lead_score\\\":0,\\\"qualification\\\":\\\"HOT|WARM|COLD\\\",\\\"appointment_requested\\\":false,\\\"escalate\\\":false}' }, {role:'user', content: `Known: name=${$json.name}, prior_score=${$json.lead_score||0}, prior_summary=${$json.conversation_summary||'none'}. New message (channel=${$node[\"Validate Input\"].json.channel}): \"${$node[\"Validate Input\"].json.message}\"` } ],\n  temperature: 0.3,\n  max_tokens: 500,\n  response_format: { type: 'json_object' }\n}) }}",
