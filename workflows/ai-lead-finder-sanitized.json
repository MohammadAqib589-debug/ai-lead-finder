    {
      "id": "cf121f85-18a3-45b6-bbe2-c372f7dbea9a",
      "name": "[1 LEAD->OUTREACH] Clean Website Text",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        960,
        -140
      ],
      "parameters": {
        "jsCode": "const res = $input.first().json;\nconst lead = $node[\"IF - Valid\"].json;\nconst html = (res.data || res.body || '').toString();\nconst text = html ? html.replace(/<script[\\s\\S]*?<\\/script>/gi,' ').replace(/<style[\\s\\S]*?<\\/style>/gi,' ').replace(/<[^>]+>/g,' ').replace(/\\s+/g,' ').trim().slice(0,3000) : '';\nreturn [{ json: { ...lead, website_text: text } }];"
      }
    },
    {
      "id": "40a73828-92f1-437c-bc48-b9b5b6340ff0",
      "name": "[1 LEAD->OUTREACH] Groq - Analyze + Score",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1200,
        -140
      ],
      "parameters": {
        "url": "https://api.groq.com/openai/v1/chat/completions",
        "method": "POST",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({\n  model: 'llama-3.3-70b-versatile',\n  messages: [ {role:'system', content: 'You are a lead qualification assistant. Never invent facts; use \\\"unknown\\\" if unsure. Return ONLY strict JSON: {\\\"lead_score\\\":0,\\\"qualification\\\":\\\"HOT|WARM|COLD|DISQUALIFIED\\\",\\\"pain_points\\\":[],\\\"sales_angle\\\":\\\"\\\",\\\"recommended_solution\\\":\\\"\\\"}' }, {role:'user', content: `Lead: ${$json.name} at ${$json.company}. Service: ${$json.service}. Message: \"${($json.message||'').slice(0,500)}\". Website: \"${($json.website_text||'').slice(0,1200)}\"` } ],\n  temperature: 0.3,\n  max_tokens: 500,\n  response_format: { type: 'json_object' }\n}) }}",
        "options": {
          "timeout": 15000,
          "response": {
            "response": {
              "neverError": true
            }
          }
        }
      },
      "continueOnFail": true,
      "retryOnFail": true,
      "maxTries": 2,
      "waitBetweenTries": 2000
    },
    {
      "id": "9a61a5ce-e991-43a2-8645-0f05484d2309",
      "name": "[1 LEAD->OUTREACH] Parse + Score (fallback safe)",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1440,
        -140
      ],
      "parameters": {
        "jsCode": "const res = $input.first().json;\nconst lead = $node[\"Clean Website Text\"].json;\nlet raw=''; try { raw = res.choices[0].message.content; } catch(e){ raw=''; }\nlet p=null;\nif(raw){ const c = raw.replace(/```json/gi,'').replace(/```/g,'').trim(); const m = c.match(/\\{[\\s\\S]*\\}/); try{ p = JSON.parse(m?m[0]:c);}catch(e){p=null;} }\nif(!p || typeof p.lead_score !== 'number'){ p = { lead_score: 0, qualification: 'COLD', pain_points: [], sales_angle: 'unknown', recommended_solution: 'unknown' }; }\nconst score = Math.max(0, Math.min(100, p.lead_score));\nreturn [{ json: { ...lead, lead_score: score, qualification: p.qualification || 'COLD', pain_points: p.pain_points||[],\n  sales_angle: p.sales_angle || 'unknown', recommended_solution: p.recommended_solution || 'unknown',\n  qualified: score >= 70, deal_stage: score >= 70 ? 'QUALIFIED' : 'NURTURE', status: score >= 70 ? 'QUALIFIED' : 'NURTURE',\n  dedupe_key: (lead.email || lead.phone || (lead.website+'|'+lead.company)).toLowerCase() } }];"
      }
    },
