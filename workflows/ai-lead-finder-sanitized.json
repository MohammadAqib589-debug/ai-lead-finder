    {
      "id": "b984a260-8f9e-4c82-b57e-3270f5b172b3",
      "name": "Note: APPOINTMENT -> REVEN",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -260,
        2320
      ],
      "parameters": {
        "content": "APPOINTMENT -> REVENUE\n\nWebhook (call this from workflow 2, or manually) -> Get Lead -> Groq Proposal draft -> Save (DRAFT) -> Human Approval (Wait) -> Gmail -> Wait for customer decision -> Accepted? -> YES: WON + revenue update / NO: LOST + follow-up.\n\nPrice is NEVER taken from the AI: it's either the known_price passed into the trigger, or the literal string \"Custom quote required\".",
        "height": 340,
