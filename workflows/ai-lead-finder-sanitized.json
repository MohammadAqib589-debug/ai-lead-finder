        "jsCode": "const res = $input.first().json;\nconst lead = $node[\"Save Lead\"].json;\nlet raw=''; try { raw = res.choices[0].message.content; } catch(e){ raw=''; }\nlet p=null;\nif(raw){ const c = raw.replace(/```json/gi,'').replace(/```/g,'').trim(); const m = c.match(/\\{[\\s\\S]*\\}/); try{ p = JSON.parse(m?m[0]:c);}catch(e){p=null;} }\nif(!p) p = { subject: 'Following up', body: 'Wanted to reach out about your business needs.' };\nreturn [{ json: { ...lead, outreach_subject: p.subject, outreach_body: p.body } }];"
