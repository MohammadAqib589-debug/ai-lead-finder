      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        960,
        1200
      ],
      "parameters": {
        "jsCode": "const res = $input.first().json;\nconst lead = $node[\"Find/Create Lead\"].json;\nlet raw=''; try { raw = res.choices[0].message.content; } catch(e){ raw=''; }\nlet p=null;\nif(raw){ const c = raw.replace(/```json/gi,'').replace(/```/g,'').trim(); const m = c.match(/\\{[\\s\\S]*\\}/); try{ p = JSON.parse(m?m[0]:c);}catch(e){p=null;} }\nif(!p){ p = { intent:'OTHER', reply:'Thanks for reaching out, a team member will follow up shortly.', lead_score:0, qualification:'COLD', appointment_requested:false, escalate:true }; }\nreturn [{ json: { ...lead, intent: p.intent, reply: p.reply, lead_score: p.lead_score||0, qualification: p.qualification||'COLD',\n  appointment_requested: !!p.appointment_requested, escalate: !!p.escalate,\n  conversation_summary: ((lead.conversation_summary||'') + ' | ' + $node[\"Validate Input\"].json.message + ' -> ' + p.reply).slice(-1500) } }];"
