    {
      "id": "a774557f-69fb-4c1d-8f99-3e806af58b91",
      "name": "[3 APPOINTMENT->REVENUE] Groq - Generate Proposal",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        480,
        2400
      ],
      "parameters": {
        "url": "https://api.groq.com/openai/v1/chat/completions",
        "method": "POST",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({\n  model: 'llama-3.3-70b-versatile',\n  messages: [ {role:'system', content: 'Draft a proposal outline. Do not mention or invent any price -- pricing is handled outside this response. Return ONLY strict JSON: {\\\"scope\\\":\\\"\\\",\\\"timeline\\\":\\\"\\\",\\\"terms\\\":\\\"\\\",\\\"next_steps\\\":\\\"\\\"}' }, {role:'user', content: `Customer: ${$json.name} at ${$json.company}. Service: ${$json.service}. Requirements: ${$json.message}.` } ],\n  temperature: 0.3,\n  max_tokens: 500,\n  response_format: { type: 'json_object' }\n}) }}",
        "options": {
          "timeout": 15000,
          "response": {
            "response": {
              "neverError": true
            }
          }
        }
      },
      "continueOnFail": true,
      "retryOnFail": true,
      "maxTries": 2,
      "waitBetweenTries": 2000
    },
    {
      "id": "8549fea2-b9fa-4e47-867c-cc645c7193da",
      "name": "[3 APPOINTMENT->REVENUE] Parse Proposal (price never from AI)",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        720,
        2400
      ],
      "parameters": {
        "jsCode": "const res = $input.first().json;\nconst lead = $node[\"Get Lead + Requirements\"].json;\nconst trigger = $node[\"Webhook - Trigger Proposal\"].json.body || {};\nlet raw=''; try { raw = res.choices[0].message.content; } catch(e){ raw=''; }\nlet p=null;\nif(raw){ const c = raw.replace(/```json/gi,'').replace(/```/g,'').trim(); const m = c.match(/\\{[\\s\\S]*\\}/); try{ p = JSON.parse(m?m[0]:c);}catch(e){p=null;} }\nif(!p) p = { scope:'unknown', timeline:'unknown', terms:'unknown', next_steps:'Schedule a call to finalize scope.' };\nconst price = trigger.known_price || 'Custom quote required';\nreturn [{ json: {\n  proposal_id: 'prop_' + Date.now(), lead_id: lead.lead_id, customer: lead.name, company: lead.company,\n  scope: p.scope, timeline: p.timeline, terms: p.terms, next_steps: p.next_steps,\n  price, status: 'DRAFT', created_at: new Date().toISOString(), email: lead.email\n}}];"
      }
    },
